* text=auto eol=lf
# Raw-source bytes are evidence: never normalize their line endings.
data/raw/** -text -whitespace
*.docx binary
*.pdf binary
*.zip binary
*.mat binary
*.png binary
*.xlsx binary
*.step binary
# MATLAB's generated vector serialization contains intentional whitespace.
results/m0/*.svg -whitespace
results/m0_acceptance/*.svg -whitespace
# Captured MATLAB console tables retain their original padding.
results/m0_acceptance/matlab_run.txt -whitespace
results/m1/*.svg -whitespace
results/m1/matlab_run.txt -whitespace
results/m1/engineering/*.svg -whitespace
results/m1/engineering/matlab_run.txt -whitespace
results/m2/*.svg -whitespace
# Raw MATLAB success/failure/diagnostic console captures retain original padding.
results/m2/*.txt -whitespace
results/m3/*.svg -whitespace
results/m3/*.txt -whitespace
