import os
run=r'E:\ansys_runs\m4_case0_20261021'
project=os.path.join(run,'Case0_heated_mesh_verification_20261022.wbpj')
assert not os.path.exists(project),'Never overwrite an existing project'
SetScriptVersion(Version='24.1.0')
Open(FilePath=os.path.join(run,'Case0_mesh_normal_verification.wbpj'))
Save(FilePath=project,Overwrite=True)
model=GetAllSystems()[0].GetContainer(ComponentName='Model')
model.Edit(Hidden=True)
model.SendCommand(Language='Python',Command="execfile(r'E:\\ansys_runs\\m4_case0_20261021\\mechanical_heated_mesh.py')")
model.Exit()
Save(FilePath=project,Overwrite=True)
